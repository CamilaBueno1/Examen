{
  "expo": {
    "name": "Control Electoral",
    "slug": "examen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/control-electoral-icon.png",
    "scheme": "examen",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "ec.controlelectoral.examen",
      "adaptiveIcon": {
        "backgroundColor": "#103B50",
        "foregroundImage": "./assets/images/control-electoral-foreground.png",
        "monochromeImage": "./assets/images/control-electoral-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/control-electoral-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite tomar fotografías de las actas electorales.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite registrar la ubicación original de la captura del acta."
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF7",
          "image": "./assets/images/control-electoral-splash.png",
          "imageWidth": 180
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9f70011d-6d3f-4e00-991f-ffb926df7b14"
      }
    },
    "owner": "camilabuenor"
  }
}
